.my-winning-page {
  min-height: 100vh;
  background: #f5f5f5;
}

.status-tabs {
  display: flex;
  background: #fff;
  padding: 0 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.status-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s;
}

.status-tab.active {
  color: #ff6b6b;
  border-bottom-color: #ff6b6b;
  font-weight: 500;
}

.tab-count {
  font-size: 22rpx;
  margin-left: 4rpx;
}

.winning-list {
  padding: 20rpx 30rpx;
}

.winning-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%);
}

.winning-cover {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.winning-info {
  flex: 1;
}

.winning-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.winning-level {
  font-size: 24rpx;
  color: #ff6b6b;
}

.winning-status {
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.winning-status.pending {
  background: #fff;
  color: #ff6b6b;
}

.winning-status.used {
  background: #f0f0f0;
  color: #999;
}

.card-body {
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.prize-detail {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.prize-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.prize-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.winning-code {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.code-label {
  color: #999;
}

.code-value {
  color: #333;
  font-family: monospace;
  margin-right: 16rpx;
}

.copy-btn {
  padding: 6rpx 16rpx;
  background: rgba(255, 107, 107, 0.1);
  color: #ff6b6b;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
}

.win-time {
  font-size: 22rpx;
  color: #999;
}

.action-btn {
  padding: 12rpx 30rpx;
  font-size: 24rpx;
  border-radius: 30rpx;
  margin: 0;
}

.btn.action-btn::after {
  border: none;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  padding: 20rpx 60rpx;
  font-size: 28rpx;
}

.btn.empty-btn::after {
  border: none;
}
