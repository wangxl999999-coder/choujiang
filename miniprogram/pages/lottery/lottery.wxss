.lottery-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 140rpx;
}

.lottery-header {
  position: relative;
  height: 400rpx;
  overflow: hidden;
}

.header-cover {
  width: 100%;
  height: 100%;
}

.header-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
}

.header-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 30rpx;
  color: #fff;
}

.lottery-title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.lottery-meta {
  display: flex;
  gap: 30rpx;
}

.meta-item {
  font-size: 24rpx;
  opacity: 0.9;
}

.lottery-body {
  margin: -60rpx 30rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 10;
}

.lottery-type-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #fff;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-bottom: 30rpx;
}

.badge-icon {
  margin-right: 8rpx;
}

.wheel-container {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0;
}

.wheel-wrapper {
  position: relative;
  width: 500rpx;
  height: 500rpx;
  margin: 0 auto;
}

.wheel {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  transition: transform 4s cubic-bezier(0.17, 0.67, 0.12, 0.99);
  box-shadow: 0 0 0 12rpx #fff, 0 0 0 16rpx #ff6b6b, 0 12rpx 32rpx rgba(0, 0, 0, 0.2);
  overflow: hidden;
}

.wheel-canvas {
  display: block;
  width: 100%;
  height: 100%;
}

.wheel-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 107, 0.4);
}

.wheel-btn {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.wheel-btn.disabled {
  opacity: 0.6;
}

.wheel-pointer {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 20rpx solid transparent;
  border-right: 20rpx solid transparent;
  border-top: 50rpx solid #ff6b6b;
  z-index: 20;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.2));
}

.grid-container {
  display: flex;
  justify-content: center;
  padding: 30rpx 0;
}

.grid-wrapper {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.grid-item {
  width: 180rpx;
  height: 180rpx;
  background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
  border: 3rpx solid transparent;
}

.grid-item.active {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  border-color: #ff4757;
  transform: scale(1.05);
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 107, 0.4);
}

.grid-item.active .grid-icon,
.grid-item.active .grid-name {
  color: #fff;
}

.grid-item-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.grid-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.grid-name {
  font-size: 22rpx;
  color: #333;
}

.start-btn {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.start-btn.disabled {
  opacity: 0.6;
}

.scroll-container {
  padding: 30rpx 0;
}

.scroll-wrapper {
  position: relative;
  height: 300rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #f8f8f8;
  margin-bottom: 30rpx;
}

.scroll-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(180deg, #f8f8f8 0%, transparent 100%);
  z-index: 10;
}

.scroll-mask::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(0deg, #f8f8f8 0%, transparent 100%);
  top: auto;
}

.scroll-track {
  transition: transform 3s cubic-bezier(0.17, 0.67, 0.12, 0.99);
}

.scroll-item {
  display: flex;
  justify-content: space-around;
  height: 150rpx;
  padding: 0 30rpx;
}

.prize-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 180rpx;
}

.cell-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.cell-name {
  font-size: 24rpx;
  color: #333;
}

.scroll-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.scroll-btn.disabled {
  opacity: 0.6;
}

.oneclick-container {
  padding: 30rpx 0;
}

.oneclick-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.prize-display {
  margin-bottom: 40rpx;
}

.display-box {
  width: 400rpx;
  height: 240rpx;
  background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ff6b6b;
}

.display-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.display-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.oneclick-btn {
  width: 300rpx;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.4);
}

.oneclick-btn.disabled {
  opacity: 0.6;
}

.chance-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
  font-size: 24rpx;
  color: #666;
}

.invite-tip {
  color: #ff6b6b;
}

.lottery-info-section {
  margin: 0 30rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.info-tabs {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}

.info-tab.active {
  color: #ff6b6b;
  border-bottom-color: #ff6b6b;
  font-weight: 500;
}

.info-content {
  padding: 30rpx;
}

.rule-item {
  display: flex;
  margin-bottom: 20rpx;
}

.rule-item:last-child {
  margin-bottom: 0;
}

.rule-num {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: #ff6b6b;
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rule-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.prize-detail-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.prize-detail-item:last-child {
  border-bottom: none;
}

.prize-detail-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.prize-detail-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.prize-detail-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.prize-detail-count {
  font-size: 22rpx;
  color: #999;
}

.prize-detail-prob {
  font-size: 24rpx;
  color: #ff6b6b;
}

.winner-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.winner-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.winner-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.winner-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 4rpx;
}

.winner-prize {
  font-size: 22rpx;
  color: #ff6b6b;
}

.winner-time {
  font-size: 20rpx;
  color: #999;
}

.empty-winners {
  text-align: center;
  padding: 40rpx 0;
  color: #999;
  font-size: 26rpx;
}

.lottery-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 50rpx;
  margin: 0;
}

.btn.footer-btn::after {
  border: none;
}

.result-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.result-content {
  width: 600rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  position: relative;
}

.result-confetti {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #ff6b6b;
  margin-bottom: 30rpx;
}

.result-prize {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.result-name {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.result-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 30rpx;
}

.result-code {
  display: inline-block;
  padding: 12rpx 30rpx;
  background: #f8f8f8;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.result-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 50rpx;
}
